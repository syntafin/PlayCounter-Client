{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlayCounter",
  "version": "0.2.2",
  "identifier": "de.syntafin.playcounter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PlayCounter",
        "width": 980,
        "height": 680,
        "minWidth": 800,
        "minHeight": 550,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVENkJFNDY5QUI2RUU5QzYKUldURzZXNnJhZVJyN1ovaFNDRlFQUnI2dTZnVkM2YjZ5Rm9ZRHlGcnVTY1NGN2x1NEU2T1RHQlkK",
      "endpoints": [
        "https://github.com/syntafin/PlayCounter-Client/releases/latest/download/latest.json",
        "https://api.syntafin.de/v1/client/updates/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Automatisierter Game-Tracker & Spielzeitzähler",
    "longDescription": "PlayCounter erfasst deine Spielzeiten auf dem PC und bietet detaillierte Sitzungsstatistiken und Bibliotheksverwaltung.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libayatana-appindicator3-1"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German",
          "English"
        ]
      }
    }
  }
}
